// Specify resources for processes based on labels
process {
    // Single-core processes
    withLabel: single {
        cpus = 1
        memory = 4.GB
    }

    withLabel: single_cpu_16GB_memory {
        cpus = 1
        memory = 16.GB
    }

    withLabel: single_cpu_32GB_memory {
        cpus = 1
        memory = 32.GB
    }

    // Small multi-core processes
    withLabel: xsmall {
        cpus = 4
        memory = 16.GB
    }
    withLabel: small {
        cpus = 8
        memory = 16.GB
    }

    // Large multi-core processes
    withLabel: large {
        cpus = 16
        memory = 32.GB
    }

    // Very large multi-core processes
    withLabel: max {
        cpus = 32
        memory = 64.GB
    }

    withLabel: kraken_resources {
        cpus = 16
        memory = 128.GB
    }

    withLabel: blast_resources {
        cpus = 32
        memory = 256.GB
    }

    withLabel: single_huge_mem {
        cpus = 1
        memory = 128.GB
    }

    // bowtie2-build compiled against libsais holds the whole suffix array in memory,
    // about 9 bytes per base, rather than spilling it in blocks. Only the contaminant
    // reference needs more than the 64 GB of `max`, so memory is tiered on the gzipped
    // reference size rather than flat: a flat allocation sized for the contaminant
    // would double the virus and human builds' footprint for no benefit and limit how
    // many tasks pack onto an instance.
    //
    // Gzipped DNA FASTA runs ~3.2 bases/byte, so the ~9 bytes/base requirement is ~29x
    // the gzipped size. Headroom against that estimate for the three real references is
    // ~3.7x (virus, 0.6 GB), ~2.4x (human, 0.9 GB) and ~1.5x (contaminant, 3.0 GB). As
    // with any tiering, the margin is thinnest just under a threshold: a 4 GB reference
    // would need ~115 GB against the 128 GB tier, ~1.1x. No current reference sits
    // there, but a new one near a boundary warrants rechecking these tiers.
    withLabel: bowtie2_index_resources {
        cpus = 32
        memory = {
            def thresholds = ['1 GB', '4 GB']
            def memories = ['64 GB', '128 GB', '256 GB']
            long bytes = reference_fasta.size()
            def idx = thresholds.findIndexOf { t -> bytes <= nextflow.util.MemoryUnit.of(t).toBytes() }
            return nextflow.util.MemoryUnit.of(idx >= 0 ? memories[idx] : memories.last())
        }
    }

    // BBDuk k-mer masking of the viral genomes against the large human genome (CHM13).
    withLabel: human_mask_resources {
        cpus = 16
        memory = 128.GB
    }

    // Cap sentinel-fan-out S3 polling concurrency; see #801.
    withLabel: sentinel {
        maxForks = 10
    }

    // Input-size-aware tiering for BBMask on gzipped FASTQ. Peak memory scales
    // ~linearly with input bases at small sizes and sub-linearly at large sizes;
    // tier thresholds are the gzipped-FASTQ byte size. See PR #737.
    withLabel: bbmask_resources {
        cpus = 16
        memory = {
            def thresholds = ['2 GB', '10 GB']
            def memories = ['32 GB', '64 GB', '128 GB']
            long bytes = (reads instanceof List) ? reads.sum { r -> r.size() } : reads.size()
            def idx = thresholds.findIndexOf { t -> bytes <= nextflow.util.MemoryUnit.of(t).toBytes() }
            return nextflow.util.MemoryUnit.of(idx >= 0 ? memories[idx] : memories.last())
        }
    }

    // Input-size-aware tiering for MARK_ALIGNMENT_DUPLICATES on the grouped-hits TSV.
    // Peak RSS scales ~linearly with the gzipped TSV size. Thresholds keep ~1.5x headroom
    // at each tier. See PR #737/#836.
    withLabel: mark_alignment_duplicates_resources {
        cpus = 16
        memory = {
            def thresholds = ['5 GB', '10 GB']
            def memories = ['32 GB', '64 GB', '128 GB']
            long bytes = (tsv instanceof List) ? tsv.sum { f -> f.size() } : tsv.size()
            def idx = thresholds.findIndexOf { t -> bytes <= nextflow.util.MemoryUnit.of(t).toBytes() }
            return nextflow.util.MemoryUnit.of(idx >= 0 ? memories[idx] : memories.last())
        }
    }

    // Input-size-aware tiering for GNU sort modules. Memory tiers keep the buffer
    // above ~uncompressed_bytes/16 so sort can merge in a single pass, assuming
    // ~10x relative to compressed sizes. CPU tiers also help speed up sort via
    // `--parallel` flag. Tiers also reduce per-instance task packing for larger
    // inputs, given all tasks on an instance share the same local disk. Tiers are
    // 4 GB/cpu and the top one is 60 GB to fit two tasks on a 128GB instance with overhead.
    // See PR #924.
    withLabel: sort_resources {
        cpus = {
            def thresholds = ['0.5 GB', '2 GB', '10 GB']
            def cpus_by_tier = [1, 4, 8, 15]
            long bytes = input_file.size()
            def idx = thresholds.findIndexOf { t -> bytes <= nextflow.util.MemoryUnit.of(t).toBytes() }
            return idx >= 0 ? cpus_by_tier[idx] : cpus_by_tier.last()
        }
        memory = {
            def thresholds = ['0.5 GB', '2 GB', '10 GB']
            def memories = ['4 GB', '16 GB', '32 GB', '60 GB']
            long bytes = input_file.size()
            def idx = thresholds.findIndexOf { t -> bytes <= nextflow.util.MemoryUnit.of(t).toBytes() }
            return nextflow.util.MemoryUnit.of(idx >= 0 ? memories[idx] : memories.last())
        }
    }
}
