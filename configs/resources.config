// Specify resources for processes based on labels
process {
    // Single-core processes
    withLabel: single {
        cpus = 1
        memory = 4.GB
    }

    withLabel: single_cpu_16GB_memory {
        cpus = 1
        memory = 16.GB
    }

    withLabel: single_cpu_32GB_memory {
        cpus = 1
        memory = 32.GB
    }

    // Small multi-core processes
    withLabel: xsmall {
        cpus = 4
        memory = 16.GB
    }
    withLabel: small {
        cpus = 8
        memory = 16.GB
    }

    // Large multi-core processes
    withLabel: large {
        cpus = 16
        memory = 32.GB
    }

    // Very large multi-core processes
    withLabel: max {
        cpus = 32
        memory = 64.GB
    }

    withLabel: kraken_resources {
        cpus = 16
        memory = 128.GB
    }

    withLabel: blast_resources {
        cpus = 32
        memory = 256.GB
    }

    withLabel: single_huge_mem {
        cpus = 1
        memory = 128.GB
    }

    // BBDuk k-mer masking of the viral genomes against the large human genome (CHM13).
    withLabel: human_mask_resources {
        cpus = 16
        memory = 128.GB
    }

    // Cap sentinel-fan-out S3 polling concurrency; see #801.
    withLabel: sentinel {
        maxForks = 10
    }

    // Input-size-aware tiering for BBMask on gzipped FASTQ. Peak memory scales
    // ~linearly with input bases at small sizes and sub-linearly at large sizes;
    // tier thresholds are the gzipped-FASTQ byte size. See PR #737.
    withLabel: bbmask_resources {
        cpus = 16
        memory = {
            def thresholds = ['2 GB', '10 GB']
            def memories = ['32 GB', '64 GB', '128 GB']
            long bytes = (reads instanceof List) ? reads.sum { r -> r.size() } : reads.size()
            def idx = thresholds.findIndexOf { t -> bytes <= nextflow.util.MemoryUnit.of(t).toBytes() }
            return nextflow.util.MemoryUnit.of(idx >= 0 ? memories[idx] : memories.last())
        }
    }

    // Input-size-aware tiering for MARK_ALIGNMENT_DUPLICATES on the grouped-hits TSV.
    // Peak RSS scales ~linearly with the gzipped TSV size. Thresholds keep ~1.5x headroom
    // at each tier. See PR #737/#836.
    withLabel: mark_alignment_duplicates_resources {
        cpus = 16
        memory = {
            def thresholds = ['5 GB', '10 GB']
            def memories = ['32 GB', '64 GB', '128 GB']
            long bytes = (tsv instanceof List) ? tsv.sum { f -> f.size() } : tsv.size()
            def idx = thresholds.findIndexOf { t -> bytes <= nextflow.util.MemoryUnit.of(t).toBytes() }
            return nextflow.util.MemoryUnit.of(idx >= 0 ? memories[idx] : memories.last())
        }
    }

    // Input-size-aware tiering for the GNU sort modules (SORT_FILE, SORT_FASTQ),
    // which stream a gzipped file through `sort`. Their cost is driven by sort's
    // buffer size, not by peak RSS: too small a buffer makes sort spill the whole
    // dataset once per 16-way merge level. Memory here sets the buffer (see
    // lib/SortUtils.groovy), and is tiered to keep the buffer above
    // uncompressed_bytes/16, which holds sort to a single merge pass. These files
    // expand ~9-11x on decompression, so thresholds on the gzipped size assume
    // ~10x; the top tier is open-ended, so an input either much larger or much
    // more compressible than that will still take more than one merge pass (it
    // degrades gradually and stays correct, it just spills more).
    // The larger reservations also bound how many concurrent sorts pack
    // onto one host, which is what limits total local-disk demand: AWS Batch on
    // EC2 schedules only on cpu and memory and ignores the `disk` directive.
    // See PR #921.
    withLabel: sort_file_resources {
        cpus = {
            def thresholds = ['0.5 GB', '2 GB', '10 GB']
            def cpus_by_tier = [1, 4, 8, 16]
            long bytes = input_file.size()
            def idx = thresholds.findIndexOf { t -> bytes <= nextflow.util.MemoryUnit.of(t).toBytes() }
            return idx >= 0 ? cpus_by_tier[idx] : cpus_by_tier.last()
        }
        memory = {
            def thresholds = ['0.5 GB', '2 GB', '10 GB']
            def memories = ['4 GB', '16 GB', '32 GB', '64 GB']
            long bytes = input_file.size()
            def idx = thresholds.findIndexOf { t -> bytes <= nextflow.util.MemoryUnit.of(t).toBytes() }
            return nextflow.util.MemoryUnit.of(idx >= 0 ? memories[idx] : memories.last())
        }
    }

    withLabel: sort_fastq_resources {
        cpus = {
            def thresholds = ['0.5 GB', '2 GB', '10 GB']
            def cpus_by_tier = [1, 4, 8, 16]
            long bytes = (fastq instanceof List) ? fastq.sum { f -> f.size() } : fastq.size()
            def idx = thresholds.findIndexOf { t -> bytes <= nextflow.util.MemoryUnit.of(t).toBytes() }
            return idx >= 0 ? cpus_by_tier[idx] : cpus_by_tier.last()
        }
        memory = {
            def thresholds = ['0.5 GB', '2 GB', '10 GB']
            def memories = ['4 GB', '16 GB', '32 GB', '64 GB']
            long bytes = (fastq instanceof List) ? fastq.sum { f -> f.size() } : fastq.size()
            def idx = thresholds.findIndexOf { t -> bytes <= nextflow.util.MemoryUnit.of(t).toBytes() }
            return nextflow.util.MemoryUnit.of(idx >= 0 ? memories[idx] : memories.last())
        }
    }
}
