nextflow_workflow {

    name "Test workflow VALIDATE_VIRAL_ASSIGNMENTS"
    script "subworkflows/local/validateViralAssignments/main.nf"
    workflow "VALIDATE_VIRAL_ASSIGNMENTS"
    config "tests/configs/downstream.config"
    tag "subworkflow"
    tag "downstream"
    tag "validate_viral_assignments"

    test("Should fail when input TSV contains duplicate read IDs") {
        tag "expect_failed"
        tag "duplicate_input"
        when {
            params {
                n_sample = 3
                taxid_artificial = 81077
            }
            workflow {
                '''
                def validation_params = [
                    validation_n_sample: params.n_sample,
                    blast_perc_id: params.blast_perc_id,
                    blast_qcov_hsp_perc: params.blast_qcov_hsp_perc,
                    blast_max_rank: params.blast_max_rank,
                    blast_min_frac: params.blast_min_frac,
                    taxid_artificial: params.taxid_artificial,
                    db_download_timeout: params.db_download_timeout,
                    platform: params.platform
                ]
                input[0] = Channel.of("test")
                    | combine(Channel.of("${projectDir}/test-data/validateViralAssignments/input_duplicate.tsv")) // groups
                input[1] = Channel.of("${params.ref_dir}/results/total-virus-db-annotated.tsv.gz") // db
                input[2] = params.ref_dir
                input[3] = validation_params
                '''
            }
        }
        then {
            assert workflow.failed
            assert workflow.exitStatus == 1
            assert workflow.errorReport.contains("ValueError: Duplicate value found in field seq_id")
        }
    }

    test("Should run without failures on valid input data") {
        tag "expect_success"
        when {
            params {
                n_sample = 3
                taxid_artificial = 81077
            }
            workflow {
                '''
                def validation_params = [
                    validation_n_sample: params.n_sample,
                    blast_perc_id: params.blast_perc_id,
                    blast_qcov_hsp_perc: params.blast_qcov_hsp_perc,
                    blast_max_rank: params.blast_max_rank,
                    blast_min_frac: params.blast_min_frac,
                    taxid_artificial: params.taxid_artificial,
                    db_download_timeout: params.db_download_timeout,
                    platform: params.platform
                ]
                input[0] = Channel.of("test")
                    | combine(Channel.of("${projectDir}/test-data/validateViralAssignments/input_valid.tsv")) // groups
                input[1] = Channel.of("${params.ref_dir}/results/total-virus-db-annotated.tsv.gz") // db
                input[2] = params.ref_dir
                input[3] = validation_params
                '''
            }
        }
        then {
            assert workflow.success
            def tabs_in = workflow.out.test_in.collect{path(it[1]).csv(sep: "\t")}
            // Concatenation across species should preserve every sampled sequence
            def sampled_fasta = workflow.out.test_sampled_fasta.collect{it[1]}.flatten().collect{path(it).fasta}
            def concat_fasta = workflow.out.test_concat_fasta.collect{path(it[1]).fasta}
            def concat_labels = workflow.out.test_concat_fasta.collect{it[0]}
            assert concat_fasta.size() == tabs_in.size()
            assert sampled_fasta.sum{ it.keySet().size() } == concat_fasta.sum{ it.keySet().size() }
            // Basic BLAST invocation should work as expected
            def blast_db = workflow.out.test_blast_db.collect{path(it[1]).csv(sep: "\t", decompress: true)}
            def blast_query = workflow.out.test_blast_query.collect{path(it[1]).fasta}
            def blast_lca = workflow.out.test_blast_lca.collect{path(it[1]).csv(sep: "\t", decompress: true)}
            assert blast_query == concat_fasta
            assert blast_db.size() == blast_query.size()
            for (int i=0; i < blast_db.size(); i++) {
                if (blast_db[i].rowCount == 0) {
                    continue
                }
                // qseqids should all be in query input
                def ids_in = blast_query[i].keySet().collect{ it.tokenize(" ")[0] }.toSet()
                def ids_out = blast_db[i].columns["qseqid"].toSet()
                assert ids_in.containsAll(ids_out)
                // LCA output should have one row per sequence in BLAST output
                assert blast_lca[i].rowCount == blast_db[i].columns["qseqid"].toSet().size()
            }
            // Taxid validation should cover exactly the reads BLAST returned hits for
            def tabs_validate = workflow.out.test_validate.collect{path(it[1]).csv(sep: "\t", decompress: true)}
            assert tabs_validate.size() == blast_lca.size()
            for (int i=0; i < tabs_validate.size(); i++) {
                if (tabs_validate[i].rowCount > 0) {
                    assert tabs_validate[i].columns["seq_id"].unique().toSorted() == blast_lca[i].columns["qseqid"].unique().toSorted()
                }
            }
            // Annotation should preserve the read set and label every read exactly once
            def tabs_annotate = workflow.out.test_annotate.collect{path(it[1]).csv(sep: "\t", decompress: true)}
            assert tabs_annotate.size() == tabs_in.size()
            for (int i=0; i < tabs_annotate.size(); i++) {
                assert tabs_annotate[i].rowCount == tabs_in[i].rowCount
                assert tabs_annotate[i].columns["seq_id"].toSorted() == tabs_in[i].columns["seq_id"].toSorted()
            }
            // Final output should preserve the read set and drop the internal taxid column
            def tabs_regrouped = workflow.out.annotated_hits.collect{path(it[1]).csv(sep: "\t", decompress: true)}
            assert tabs_regrouped.size() == tabs_in.size()
            for (int i=0; i < tabs_regrouped.size(); i++) {
                assert tabs_regrouped[i].rowCount == tabs_in[i].rowCount
                assert tabs_regrouped[i].columns["seq_id"].unique().toSorted() == tabs_in[i].columns["seq_id"].unique().toSorted()
                assert !tabs_regrouped[i].columnNames.contains("taxid_species")
                assert tabs_regrouped[i].columnNames.contains("selected_taxid")
                assert tabs_regrouped[i].columnNames.contains("validation_status")
                // No cluster machinery should survive in the output
                assert tabs_regrouped[i].columnNames.every{ !it.startsWith("vsearch_") }
                assert !tabs_regrouped[i].columnNames.contains("group_species")
                // Partitioning by selected_taxid leaves the table grouped by taxid, so the
                // final sort must put it back in seq_id order. Every other assertion here
                // compares sorted collections and so cannot see ordering at all.
                assert tabs_regrouped[i].columns["seq_id"] == tabs_regrouped[i].columns["seq_id"].toSorted()
            }
        }
    }

    test("Should create empty validation_hits for header-only input") {
        tag "expect_success"
        tag "empty_input"
        when {
            params {
                n_sample = 3
                taxid_artificial = 81077
            }
            workflow {
                '''
                def validation_params = [
                    validation_n_sample: params.n_sample,
                    blast_perc_id: params.blast_perc_id,
                    blast_qcov_hsp_perc: params.blast_qcov_hsp_perc,
                    blast_max_rank: params.blast_max_rank,
                    blast_min_frac: params.blast_min_frac,
                    taxid_artificial: params.taxid_artificial,
                    db_download_timeout: params.db_download_timeout,
                    platform: params.platform
                ]
                input[0] = Channel.of("empty_group")
                    | combine(Channel.of("${projectDir}/test-data/validateViralAssignments/input_header_only.tsv")) // groups
                input[1] = Channel.of("${params.ref_dir}/results/total-virus-db-annotated.tsv.gz") // db
                input[2] = params.ref_dir
                input[3] = validation_params
                '''
            }
        }
        then {
            assert workflow.success
            // Should produce one empty validation_hits file for the group
            assert workflow.out.annotated_hits.size() == 1
            def output = workflow.out.annotated_hits[0]
            assert output[0] == "empty_group"
            assert output[1].toString().contains("validation_hits")
            // The file should contain only the header row (the schema for
            // validation_hits defines the expected columns)
            assert path(output[1]).linesGzip.size() == 1
        }
    }

}
