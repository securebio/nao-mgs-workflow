nextflow_workflow {

    name "Test workflow DOWNSAMPLE_VIRAL_ASSIGNMENTS"
    script "subworkflows/local/downsampleViralAssignments/main.nf"
    workflow "DOWNSAMPLE_VIRAL_ASSIGNMENTS"
    config "tests/configs/downstream.config"
    tag "subworkflow"
    tag "downstream"
    tag "downsample_viral_assignments"

    test("Should downsample interleaved partitions and emit one FASTA per partition") {
        tag "expect_success"
        when {
            params {
                n_sample = 4
            }
            workflow {
                '''
                input[0] = channel.of(["test", [
                    "${projectDir}/test-data/downsampleViralAssignments/partition_10239_hits.tsv",
                    "${projectDir}/test-data/downsampleViralAssignments/partition_186538_hits.tsv"
                ]])
                input[1] = params.n_sample
                input[2] = channel.of(false)
                '''
            }
        }
        then {
            assert workflow.success
            // One grouped emission per label, regardless of how many partitions it held
            assert workflow.out.tsv.size() == 1
            assert workflow.out.tsv[0][0] == "test"
            def sampled = workflow.out.tsv.collectMany{it[1]}.collect{path(it).csv(sep: "\t")}
            assert sampled.size() == 2
            // The cap applies per partition: 10-row partition capped at 4, 3-row passed whole
            assert sampled.collect{it.rowCount}.toSorted() == [3, 4]

            // Every output file carries its partition taxid, and FASTQ/FASTA record names
            // carry a " 1"/" 2" mate suffix on top of the seq_id
            def taxidOf = { f -> (f.toString() =~ /_(\d+)_/)[0][1] }
            def seqIdOf = { name -> name.tokenize(" ")[0] }

            // Track identities per partition, not just totals: comparing only aggregate
            // counts would survive a read being dropped from one partition and duplicated
            // in another, or reads being cross-wired between partitions.
            def sampled_ids = [:]
            workflow.out.tsv[0][1].each { f ->
                sampled_ids[taxidOf(f)] = path(f).csv(sep: "\t").columns["seq_id"].toSet()
            }
            assert sampled_ids.keySet().toSorted() == ["10239", "186538"]
            // Retained reads must come from the partition they were drawn from
            sampled_ids.each { taxid, ids ->
                ids.each { id -> assert id.startsWith("read_${taxid}_") }
            }

            // Each retained read pair becomes exactly two interleaved FASTQ records, and
            // the FASTQ holds precisely the reads that were sampled for that partition
            def fastq_ids = [:]
            workflow.out.fastq[0][1].each { f ->
                def fq = path(f).fastq
                fastq_ids[taxidOf(f)] = fq.readNames.collect{ n -> seqIdOf(n) }.toSet()
                assert fq.sequences.size() == sampled_ids[taxidOf(f)].size() * 2
            }
            assert fastq_ids == sampled_ids

            // ...and then exactly one merged/joined FASTA record per sampled pair
            def fasta_ids = [:]
            workflow.out.fasta[0][1].each { f ->
                def fa = path(f).fasta
                fasta_ids[taxidOf(f)] = fa.keySet().collect{ n -> seqIdOf(n) }.toSet()
                assert fa.keySet().size() == sampled_ids[taxidOf(f)].size()
            }
            assert fasta_ids == sampled_ids

            def names = workflow.out.tsv[0][1].collect{ it.toString().tokenize("/")[-1] }
            assert names == names.toSorted()
        }
    }

    test("Should emit the grouped partitions in filename order") {
        tag "expect_success"
        tag "grouping_order"
        when {
            params {
                n_sample = 2
            }
            workflow {
                // Partitions are downsampled as independent tasks and regrouped, and
                // groupTuple emits in completion order -- a race between those tasks.
                // Six partitions are supplied in reverse-lexicographic order so that an
                // unsorted regrouping would have to win a 1-in-720 shuffle to look sorted,
                // while the sort in the subworkflow makes this pass every time. Two
                // partitions were not enough: unsorted output came out sorted by chance
                // roughly three runs in four.
                '''
                input[0] = channel.of(["test", [
                    "${projectDir}/test-data/downsampleViralAssignments/partition_31631_hits.tsv",
                    "${projectDir}/test-data/downsampleViralAssignments/partition_2697049_hits.tsv",
                    "${projectDir}/test-data/downsampleViralAssignments/partition_186538_hits.tsv",
                    "${projectDir}/test-data/downsampleViralAssignments/partition_12475_hits.tsv",
                    "${projectDir}/test-data/downsampleViralAssignments/partition_11676_hits.tsv",
                    "${projectDir}/test-data/downsampleViralAssignments/partition_10239_hits.tsv"
                ]])
                input[1] = params.n_sample
                input[2] = channel.of(false)
                '''
            }
        }
        then {
            assert workflow.success
            def names = workflow.out.tsv[0][1].collect{ it.toString().tokenize("/")[-1] }
            assert names.size() == 6
            assert names == names.toSorted()
        }
    }

    test("Should handle single-end input without merging") {
        tag "expect_success"
        when {
            params {
                n_sample = 4
            }
            workflow {
                '''
                input[0] = channel.of(["test", [
                    "${projectDir}/test-data/downsampleViralAssignments/partition_10239_hits_single.tsv"
                ]])
                input[1] = params.n_sample
                input[2] = channel.of(true)
                '''
            }
        }
        then {
            assert workflow.success
            def sampled = workflow.out.tsv.collectMany{it[1]}.collect{path(it).csv(sep: "\t")}
            def fastas = workflow.out.fasta.collectMany{it[1]}.collect{path(it).fasta}
            assert sampled[0].rowCount == params.n_sample
            assert fastas[0].keySet().size() == params.n_sample
            // The FASTA must hold precisely the sampled reads, not merely the right number
            def seqIdOf = { name -> name.tokenize(" ")[0] }
            def sampled_ids = sampled[0].columns["seq_id"].toSet()
            assert fastas[0].keySet().collect{ n -> seqIdOf(n) }.toSet() == sampled_ids
            // No BBMerge summary is produced on the single-end path
            assert workflow.out.test_bbmerge_summary.size() == 0
        }
    }

}
