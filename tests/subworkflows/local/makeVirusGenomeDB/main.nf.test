nextflow_workflow {

    name "Test workflow MAKE_VIRUS_GENOME_DB"
    script "subworkflows/local/makeVirusGenomeDB/main.nf"
    workflow "MAKE_VIRUS_GENOME_DB"
    config "tests/configs/index.config"
    tag "subworkflow"
    tag "make_virus_genome_db"

    // Murine adenovirus 1 (taxid 10530) has two assemblies with a shared sequence:
    // GCA_000844265.1 with M22245.1 only, and GCA_023158175.1 with M22245.1
    // and nine others.
    //
    // Production config has to be modified to let both assemblies through:
    //   - `datasets_summary_extra_args` does not include `--assembly-level complete`. The two
    //     assemblies are Chromosome and Contig.
    //   - `genome_patterns_exclude` is empty. Production lists M22245.1 in
    //     ref/hv_patterns_exclude.txt.
    //   - `virus_db` is a one-row fixture for 10530, which the tiny taxonomy the
    //     other index tests build does not carry.
    //   - `host_taxa_screen` is `vertebrate`. Murine adenovirus is not human-infecting.
    //
    // With `viral_accession_chunk_size = 1` the two accessions land in separate
    // chunks, so this also covers the accession-sort and chunk-name-sort
    // links the deduplication depends on, which no module-level test can reach.
    test("Deduplicates a sequence shared by two assemblies") {
        tag "expect_success"
        when {
            params {}
            workflow {
                '''
                input[0] = "10530"
                input[1] = params.assembly_source
                input[2] = file("${projectDir}/test-data/makeVirusGenomeDB/virus-db-annotated.tsv")
                input[3] = params.collectEntries { key, value -> [key, value] } + [
                    k: "20",
                    hdist: "3",
                    entropy: "0.5",
                    polyx_len: "10",
                    datasets_summary_extra_args: "",
                    genome_patterns_exclude: "${projectDir}/test-data/toy-data/empty_file.txt",
                    host_taxa_screen: "vertebrate",
                ]
                '''
            }
        }
        then {
            assert workflow.success
            def metadata = path(workflow.out.metadata[0]).csv(sep: "\t", decompress: true)
            def fastaIdList = path(workflow.out.fasta[0]).linesGzip
                .findAll { it.startsWith(">") }
                .collect { it.substring(1).split(/\s/)[0] }
            def fastaIds = fastaIdList.toSet()

            // Both assemblies have to survive enumeration, filtering and download,
            // or the shared sequence is packaged only once and the deduplication
            // this test exists to cover never runs. Lower bounds rather than
            // exact matches, so NCBI adding a further assembly for this taxon
            // does not fail a test whose subject still holds.
            assert metadata.columns["assembly_accession"].containsAll([
                "GCA_000844265.1",
                "GCA_023158175.1",
            ]) :
                "Expected both assemblies, got: " +
                "${metadata.columns["assembly_accession"].toSet()}"
            assert metadata.columns["genome_id"].count { it == "M22245.1" } == 1 :
                "The shared sequence should be reconciled to a single metadata row"

            assert "M22245.1" in fastaIds :
                "The shared sequence should reach the published FASTA, got: ${fastaIds}"
            // A list rather than a set, so a duplicate is visible rather than
            // collapsed before the check.
            assert fastaIdList.countBy { it }.every { id, n -> n == 1 } :
                "Duplicated IDs: ${fastaIdList.countBy { it }.findAll { id, n -> n > 1 }}"
            // Sorted lists rather than sets, so a duplicate on either side stays
            // visible instead of collapsing before the comparison.
            def metadataIds = metadata.columns["genome_id"]
            assert fastaIdList.toSorted() == metadataIds.toSorted() :
                "Metadata and genome DB disagree; sequences with no row: " +
                "${(fastaIds - metadataIds.toSet()).take(5)}, rows with no sequence: " +
                "${(metadataIds.toSet() - fastaIds).take(5)}"

            // M22245.1 is packaged in two assemblies. NCBI accession.version is
            // immutable, so both copies carry the same sequence and the choice
            // only decides which assembly the metadata credits. RECONCILE_GENOME_
            // METADATA states that policy -- lowest assembly_accession -- rather
            // than inheriting whichever copy happened to survive deduplication.
            def assemblyById = [
                metadataIds, metadata.columns["assembly_accession"]
            ].transpose().collectEntries { id, acc -> [id, acc.toString()] }
            assert assemblyById["M22245.1"] == "GCA_000844265.1" :
                "Expected the lowest accession, got ${assemblyById["M22245.1"]}"

            // The published column set is what RUN's read_genbank_metadata and
            // DOWNSTREAM read, so a change upstream should surface here.
            assert metadata.columnNames == [
                "assembly_accession",
                "taxid",
                "organism_name",
                "source_database",
                "assembly_status",
                "release_date",
                "species_taxid",
                "genome_id",
                "seq_length",
                "seq_hash",
            ]
            assert workflow.out.metadata[0].toString().endsWith("virus-genome-metadata-gid.tsv.gz")

            // The sequence summary reaches the published table, and describes the
            // sequence actually published: every row carries a fixed-width digest
            // and a length matching the FASTA record it names.
            assert metadata.columns["seq_hash"].every { it.length() == 64 }
            def lengthById = [
                metadataIds, metadata.columns["seq_length"]
            ].transpose().collectEntries { id, len -> [id, len as int] }
            def fastaLengths = [:]
            def currentId = null
            path(workflow.out.fasta[0]).linesGzip.each { line ->
                if (line.startsWith(">")) {
                    currentId = line.substring(1).split(/\s/)[0]
                    fastaLengths[currentId] = 0
                } else {
                    fastaLengths[currentId] += line.trim().length()
                }
            }
            assert lengthById == fastaLengths :
                "seq_length disagrees with the published FASTA for: " +
                "${lengthById.findAll { id, len -> fastaLengths[id] != len }.take(5)}"
        }
    }
}
