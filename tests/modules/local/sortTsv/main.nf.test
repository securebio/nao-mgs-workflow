def checkPlaintextSorted = { file -> ["bash", "-c", "cat " + file + " | tail -n +2 | sort -t '\t' -k1,1 -C && printf 1 || printf 0"].execute().text.trim() as Integer }

nextflow_process {

    name "Test process SORT_TSV"
    script "modules/local/sortTsv/main.nf"
    process "SORT_TSV"
    config "tests/configs/run.config"
    tag "module"
    tag "sort_tsv"

    test("End-to-end crash test with valid input"){
        tag "expect_success"
        tag "valid_input"
        when {
            params {}
            process {
                '''
                input[0] = Channel.of("test")
                    | combine(Channel.of("${projectDir}/test-data/toy-data/test_tab_unsorted.tsv"))
                input[1] = "x"
                '''
            }
        }
        then {
            // Should run without failures
            assert process.success
            // Output should be created and sorted
            def output_sorted = checkPlaintextSorted(process.out.sorted[0][1])
            assert output_sorted == 1
        }
    }

    test("Header-only input is passed through unchanged"){
        tag "expect_success"
        when {
            params {}
            process {
                '''
                input[0] = Channel.of("test")
                    | combine(Channel.of("${projectDir}/test-data/toy-data/test_tab_empty.tsv"))
                input[1] = "x"
                '''
            }
        }
        then {
            assert process.success
            // Header survives, and no data rows are invented
            assert path(process.out.sorted[0][1]).readLines() == ["x\ty\tz"]
        }
    }

    test("Header-only input with no trailing newline keeps its header"){
        tag "expect_success"
        when {
            params {}
            process {
                '''
                input[0] = Channel.of("test")
                    | combine(Channel.of("${projectDir}/test-data/toy-data/test_tab_no_trailing_newline.tsv"))
                input[1] = "x"
                '''
            }
        }
        then {
            assert process.success
            // read returns non-zero at EOF on an unterminated final line; the header
            // must survive rather than being treated as an empty input
            assert path(process.out.sorted[0][1]).readLines() == ["x\ty\tz"]
        }
    }

    test("Gzipped input is sorted and re-compressed"){
        tag "expect_success"
        // Compress the plaintext fixture at test time rather than committing a .gz,
        // so the test data stays readable in the repo.
        setup {
            run("GZIP_FILE") {
                script "modules/local/gzipFile/main.nf"
                process {
                    '''
                    input[0] = Channel.of("test")
                        | combine(Channel.of("${projectDir}/test-data/toy-data/test_tab_unsorted.tsv"))
                    '''
                }
            }
        }
        when {
            params {}
            process {
                '''
                input[0] = GZIP_FILE.out
                input[1] = "x"
                '''
            }
        }
        then {
            assert process.success
            // Output keeps the .gz suffix and the header stays first after sorting
            assert process.out.sorted[0][1].toString().endsWith(".gz")
            assert path(process.out.sorted[0][1]).linesGzip == ["x\tv\tw", "0\t1\t2", "3\t4\t5", "6\t7\t8"]
        }
    }

    test("Zero-byte input produces empty output"){
        tag "expect_success"
        when {
            params {}
            process {
                '''
                input[0] = Channel.of("test")
                    | combine(Channel.of("${projectDir}/test-data/toy-data/test_tab_zero_byte.tsv"))
                input[1] = "x"
                '''
            }
        }
        then {
            assert process.success
            // No header at all: emit an empty file rather than failing on the missing column
            assert path(process.out.sorted[0][1]).text == ""
        }
    }

    test("Missing sort field fails the process"){
        tag "expect_failed"
        when {
            params {}
            process {
                '''
                input[0] = Channel.of("test")
                    | combine(Channel.of("${projectDir}/test-data/toy-data/test_tab_unsorted.tsv"))
                input[1] = "not_a_column"
                '''
            }
        }
        then {
            assert process.failed
        }
    }

}
