nextflow_process {

    name "Test process SAMPLE_TSV_BY_HASH_LIST"
    script "modules/local/sampleTsvByHash/main.nf"
    process "SAMPLE_TSV_BY_HASH_LIST"
    config "tests/configs/downstream.config"
    tag "module"
    tag "sample_tsv_by_hash"

    test("Should cap each input file at n_sample rows and preserve partition names") {
        tag "expect_success"
        when {
            params {
                n_sample = 5
            }
            process {
                '''
                input[0] = ["test", [
                    "${projectDir}/test-data/sampleTsvByHash/partition_10239_hits.tsv.gz",
                    "${projectDir}/test-data/sampleTsvByHash/partition_186538_hits.tsv.gz"
                ]]
                input[1] = "seq_id"
                input[2] = params.n_sample
                '''
            }
        }
        then {
            assert process.success
            assert process.out.output[0][0] == "test"
            def outs = process.out.output[0][1].collect{ path(it) }
            def ins = process.out.input[0][1].collect{ path(it) }
            assert outs.size() == 2
            // Output names must keep the partition_<taxid>_ segment, since downstream
            // processes parse the taxid out of the filename
            outs.each { assert it.toString().contains("partition_") }
            outs.each { assert it.toString().tokenize("/")[-1].startsWith("sampled_") }
            // 12-row partition is capped at 5; 2-row partition is passed through whole
            def counts = outs.collect{ it.csv(sep: "\t", decompress: true).rowCount }.toSorted()
            assert counts == [2, 5]
            // Headers must be preserved unchanged
            for (int i = 0; i < outs.size(); i++) {
                assert outs[i].csv(sep: "\t", decompress: true).columnNames ==
                    ins[i].csv(sep: "\t", decompress: true).columnNames
            }
            // Retained reads must be a subset of the corresponding input
            def in_ids = ins.collectMany{ it.csv(sep: "\t", decompress: true).columns["seq_id"] }.toSet()
            def out_ids = outs.collectMany{ it.csv(sep: "\t", decompress: true).columns["seq_id"] }
            assert in_ids.containsAll(out_ids)
            assert out_ids.size() == out_ids.toSet().size()
        }
    }

    test("Should keep every row when n_sample exceeds the input size") {
        tag "expect_success"
        when {
            params {
                n_sample = 1000
            }
            process {
                '''
                input[0] = ["test", ["${projectDir}/test-data/sampleTsvByHash/partition_10239_hits.tsv.gz"]]
                input[1] = "seq_id"
                input[2] = params.n_sample
                '''
            }
        }
        then {
            assert process.success
            // A single-file output arrives as a bare path rather than a list
            def out_files = process.out.output[0][1]
            def in_files = process.out.input[0][1]
            def tab_out = path(out_files instanceof List ? out_files[0] : out_files).csv(sep: "\t", decompress: true)
            def tab_in = path(in_files instanceof List ? in_files[0] : in_files).csv(sep: "\t", decompress: true)
            assert tab_out.rowCount == tab_in.rowCount
            assert tab_out.columns["seq_id"].toSorted() == tab_in.columns["seq_id"].toSorted()
        }
    }

    test("Should select the same rows across independent invocations") {
        tag "expect_success"
        tag "reproducibility"
        when {
            params {
                n_sample = 5
            }
            process {
                '''
                input[0] = ["test", ["${projectDir}/test-data/sampleTsvByHash/partition_10239_hits.tsv.gz"]]
                input[1] = "seq_id"
                input[2] = params.n_sample
                '''
            }
        }
        then {
            assert process.success
            // Selection is a pure function of seq_id, so this snapshot is stable. A
            // change here means selection has become run- or order-dependent.
            def out_files = process.out.output[0][1]
            def out_file = out_files instanceof List ? out_files[0] : out_files
            assert snapshot(
                path(out_file).csv(sep: "\t", decompress: true).columns["seq_id"].toSorted()
            ).match("selected_ids")
        }
    }

    test("Should fail when the key column is absent") {
        tag "expect_failed"
        when {
            params {
                n_sample = 5
            }
            process {
                '''
                input[0] = ["test", ["${projectDir}/test-data/sampleTsvByHash/partition_10239_hits.tsv.gz"]]
                input[1] = "nonexistent_column"
                input[2] = params.n_sample
                '''
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains("not found in header")
        }
    }

}
