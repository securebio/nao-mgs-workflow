nextflow_process {

    name "Test process FILTER_GENOME_FASTA"
    script "modules/local/filterGenomeFasta/main.nf"
    process "FILTER_GENOME_FASTA"
    config "tests/configs/index.config"
    tag "module"
    tag "filterGenomeFasta"

    test("Should drop sequences whose headers match an exclusion pattern and keep the rest") {
        tag "expect_success"
        setup {
            run("GZIP_FILE_BARE") {
                script "modules/local/gzipFile/main.nf"
                process {
                    '''
                    input[0] = Channel.of("${projectDir}/test-data/toy-data/test-genome-exclude.fasta")
                    '''
                }
            }
        }
        when {
            process {
                '''
                input[0] = GZIP_FILE_BARE.out
                input[1] = "${projectDir}/test-data/toy-data/test-hv-patterns-exclude.txt"
                input[2] = "genomes-filtered"
                '''
            }
        }
        then {
            assert process.success
            assert process.out[0][0].toString().contains('genomes-filtered.fasta.gz')
            def headers = path(process.out[0][0]).linesGzip
                .findAll { it.startsWith('>') }
                .collect { it.substring(1) }
            // Both excluded HERV-K113 accessions are gone; unmatched sequences survive.
            assert headers.size() == 2
            assert headers.any { it.contains('KEEP_ME') }
            assert !headers.any { it.contains('AY037928') || it.contains('NC_022518') }
            // Exclusion is header-exact, not ID-based: the `recomb` record is
            // dropped even though a retained record shares its ID. Selecting by
            // ID (e.g. `seqtk subseq`) would re-admit it, leaving downstream
            // by-ID dedup free to keep the excluded record over the clean one.
            assert headers.count { it.startsWith('SHARED_ID.1') } == 1
            assert !headers.any { it.contains('recombinant') } :
                "Pattern-matching record sharing an ID with a retained record should still be excluded"
        }
    }

    test("Should fail loudly when every header matches an exclusion pattern") {
        // `set -euo pipefail` would otherwise abort on grep's no-match exit
        // status with an empty error report, rather than saying what happened.
        tag "expect_failed"
        setup {
            run("GZIP_FILE_BARE") {
                script "modules/local/gzipFile/main.nf"
                process {
                    '''
                    input[0] = Channel.of("${projectDir}/test-data/toy-data/test-genome-exclude.fasta")
                    '''
                }
            }
        }
        when {
            process {
                '''
                input[0] = GZIP_FILE_BARE.out
                input[1] = "${projectDir}/test-data/toy-data/test-hv-patterns-exclude-all.txt"
                input[2] = "genomes-filtered"
                '''
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains("Every sequence header matched a pattern") :
                "Expected the all-excluded guard to fire, got: ${process.errorReport}"
        }
    }
}
