nextflow_process {

    name "Test process CONCATENATE_GENOME_FASTA"
    script "modules/local/concatenateGenomeFasta/main.nf"
    process "CONCATENATE_GENOME_FASTA"
    config "tests/configs/index.config"
    tag "module"
    tag "concatenate_genome_fasta"

    // Load shared helper functions
    def shell = new GroovyShell()
    def helpers = shell.parse(new File("tests/helpers/FileHelpers.groovy"))

    test("Drops duplicate-ID sequences and keeps first occurrence") {
        // Fixtures contain three FASTA files exercising the four relevant
        // cases for `seqkit rmdup`:
        //   - same ID + different sequence (SHARED_NAME_DIFF_SEQ): keep first occurrence
        //   - same ID + identical sequence (SHARED_NAME_SAME_SEQ): keep first occurrence
        //   - same ID + different description (SHARED_ID_DIFF_DESC): keep first occurrence
        //   - different IDs + identical sequence (DIFF_NAME_SAME_SEQ_A/B): keep both
        // The committed fixtures are plain `.fna` for legibility; gzipFixtureDir
        // produces a temp dir of `.fna.gz` copies so the process consumes the
        // production .gz form.
        tag "expect_success"
        when {
            params {}
            process {
                """
                input[0] = file("${helpers.gzipFixtureDir("${projectDir}/test-data/concatenateGenomeFasta/genomes")}/*.fna.gz")
                """
            }
        }
        then {
            assert process.success
            def fasta = path(process.out[0][0]).fasta
            // Keys are full headers
            assert fasta.keySet().sort() == [
                "DIFF_NAME_SAME_SEQ_A",
                "DIFF_NAME_SAME_SEQ_B",
                "SHARED_ID_DIFF_DESC first description",
                "SHARED_NAME_DIFF_SEQ",
                "SHARED_NAME_SAME_SEQ",
                "UNIQUE_A",
                "UNIQUE_B",
                "UNIQUE_C",
            ]
            // rmdup keeps the first occurrence (from GCA_002.fna.gz, which
            // sorts before GCA_003.fna.gz) and drops the duplicate.
            assert fasta["SHARED_NAME_DIFF_SEQ"] == "AAAAAAAA"
            // Output is in sorted filename order.
            def headers = path(process.out[0][0]).linesGzip
                .findAll { it.startsWith(">") }
                .collect { it.substring(1) }
            assert headers == [
                "UNIQUE_A",             // GCA_001
                "DIFF_NAME_SAME_SEQ_A",
                "UNIQUE_B",             // GCA_002
                "SHARED_NAME_DIFF_SEQ",
                "SHARED_NAME_SAME_SEQ",
                "SHARED_ID_DIFF_DESC first description",
                "UNIQUE_C",             // GCA_003 (SHARED_* dropped by dedup)
                "DIFF_NAME_SAME_SEQ_B",
            ]
        }
    }

    test("Should fail loudly when given no genome FASTA files") {
        // The empty-input guard must exit 1 rather than emit an empty FASTA.
        tag "expect_failed"
        when {
            params {}
            process {
                """
                input[0] = []
                """
            }
        }
        then {
            assert process.failed
            // Assert on the guard's own message, so an unrelated failure
            // (missing container, seqkit error) can't pass this test.
            assert process.errorReport.contains("No genome FASTA files found") :
                "Expected the empty-input guard to fire, got: ${process.errorReport}"
        }
    }

}
