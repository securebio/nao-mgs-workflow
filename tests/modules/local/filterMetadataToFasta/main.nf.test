nextflow_process {

    name "Test process FILTER_METADATA_TO_FASTA"
    script "modules/local/filterMetadataToFasta/main.nf"
    process "FILTER_METADATA_TO_FASTA"
    config "tests/configs/index.config"
    tag "module"
    tag "filter_metadata_to_fasta"

    // Load shared helper functions
    def shell = new GroovyShell()
    def helpers = shell.parse(new File("tests/helpers/FileHelpers.groovy"))

    test("Drops metadata rows for sequences absent from the genome DB") {
        tag "expect_success"
        when {
            params {}
            process {
                """
                input[0] = file("${helpers.gzipFixtureDir("${projectDir}/test-data/filterMetadataToFasta/metadata")}/virus-genome-metadata-gid-unfiltered.tsv.gz")
                input[1] = file("${helpers.gzipFixtureDir("${projectDir}/test-data/filterMetadataToFasta/genomes")}/virus-genomes-masked.fasta.gz")
                input[2] = "virus-genome"
                """
            }
        }
        then {
            assert process.success
            assert process.out[0][0].toString().contains("virus-genome-metadata-gid.tsv.gz")
            def metadata = path(process.out[0][0]).csv(sep: "\t", decompress: true)
            assert metadata.columns["genome_id"] == ["NC_000001.1", "UNIQUE_A", "UNIQUE_B"]
            // UNIQUE_A is listed under GCA_000000004.1 before GCA_000000001.1, so
            // keeping the smaller accession -- the copy `seqkit rmdup` retains --
            // is visibly not the same as keeping whichever row came first.
            assert metadata.columns["assembly_accession"] ==
                ["GCF_000000001.1", "GCA_000000001.1", "GCA_000000002.1"]
            // Column set is untouched
            assert metadata.columnNames == [
                "assembly_accession",
                "taxid",
                "organism_name",
                "source_database",
                "assembly_status",
                "release_date",
                "species_taxid",
                "genome_id",
            ]
        }
    }

    test("Should fail loudly when a sequence has no metadata row") {
        tag "expect_failed"
        when {
            params {}
            process {
                """
                input[0] = file("${helpers.gzipFixtureDir("${projectDir}/test-data/filterMetadataToFasta/metadata-missing-row")}/virus-genome-metadata-gid-unfiltered.tsv.gz")
                input[1] = file("${helpers.gzipFixtureDir("${projectDir}/test-data/filterMetadataToFasta/genomes")}/virus-genomes-masked.fasta.gz")
                input[2] = "virus-genome"
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains("have no metadata row") :
                "Expected the unmatched-sequence guard to fire, got: ${process.errorReport}"
            assert process.errorReport.contains("UNIQUE_B") :
                "Error should name the offending sequence, got: ${process.errorReport}"
        }
    }

    test("Should fail loudly when duplicate rows disagree on taxonomy") {
        tag "expect_failed"
        when {
            params {}
            process {
                """
                input[0] = file("${helpers.gzipFixtureDir("${projectDir}/test-data/filterMetadataToFasta/metadata-conflicting-taxid")}/virus-genome-metadata-gid-unfiltered.tsv.gz")
                input[1] = file("${helpers.gzipFixtureDir("${projectDir}/test-data/filterMetadataToFasta/genomes")}/virus-genomes-masked.fasta.gz")
                input[2] = "virus-genome"
                """
            }
        }
        then {
            assert process.failed
            assert process.errorReport.contains("disagree on taxid") :
                "Expected the taxonomy-conflict guard to fire, got: ${process.errorReport}"
            assert process.errorReport.contains("UNIQUE_A") :
                "Error should name the offending sequence, got: ${process.errorReport}"
        }
    }

}
