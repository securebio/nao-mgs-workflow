nextflow_process {
    name "Test process MINIMAP2_SPLIT_INDEX"
    script "modules/local/minimap2/main.nf"
    process "MINIMAP2_SPLIT_INDEX"
    config "tests/configs/run_ont.config"

    tag "module"
    tag "minimap2"

    setup {
        run("LOAD_SAMPLESHEET") {
            script "subworkflows/local/loadSampleSheet/main.nf"
            process {
                """
                input[0] = "${projectDir}/test-data/ont-samplesheet.csv"
                input[1] = "ont"
                input[2] = false
                """
            }
        }
        run("MINIMAP2_INDEX_MULTIPART") {
            script "tests/helpers/minimap2_multipart_index.nf"
            process {
                """
                input[0] = [
                    file("${projectDir}/test-data/toy-data/test-random.fasta"),
                    file("${projectDir}/test-data/toy-data/norovirus_GI.fasta"),
                    file("${projectDir}/test-data/toy-data/test-genome-exclude.fasta"),
                    file("${projectDir}/test-data/tiny-index/genomes/rrna.fasta"),
                    file("${projectDir}/test-data/tiny-index/genomes/phage.fasta"),
                ]
                input[1] = "2k"
                """
            }
        }
    }

    test("When run against contaminant index, should correctly partition reads based on alignment status") {
        tag "expect_success"

        when {
            params {
            }
            process {
                '''
                def minimap2_params = [
                    suffix: "test",
                    remove_sq: false,
                    alignment_params: "",
                    db_download_timeout: params.db_download_timeout
                ]
                input[0] = LOAD_SAMPLESHEET.out.samplesheet
                input[1] = "${params.ref_dir}/results/mm2-other-index"
                input[2] = minimap2_params
                '''
            }
        }
        then {
            // Should run without failures
            assert process.success

            // Check all expected output files exist
            assert path(process.out.sam[0][1]).exists()
            assert path(process.out.reads_mapped[0][1]).exists()
            assert path(process.out.reads_unmapped[0][1]).exists()
            assert path(process.out.input[0][1]).exists()

            // Get read IDs from output FASTQ files
            def fastq_mapped = path(process.out.reads_mapped[0][1]).fastq
            def fastq_unmapped = path(process.out.reads_unmapped[0][1]).fastq
            def fastq_read_ids_mapped = fastq_mapped.readNames.toSet()
            def fastq_read_ids_unmapped = fastq_unmapped.readNames.toSet()

            // Get read IDs from SAM file
            def samlines = sam(process.out.sam[0][1]).getSamLines()
            def sam_read_ids_mapped = samlines
                .collect { line -> line.split('\t')[0] }  // Get read IDs
                .toSet()

            // Get input read IDs
            def input_reads = path(process.out.input[0][1]).fastq.readNames.toSet()

            // Verify read partitioning is correct
            assert sam_read_ids_mapped == fastq_read_ids_mapped

            // Verify no overlapping reads between mapped and unmapped sets
            assert fastq_read_ids_mapped.intersect(fastq_read_ids_unmapped).size() == 0

            // Verify input FASTQ contains all reads
            assert input_reads == fastq_read_ids_mapped + fastq_read_ids_unmapped
        }
    }

    // The index above is single-part, so it does not cover the --split-prefix
    // merge that is this process's whole reason for existing. This runs the same
    // partitioning assertions against a deliberately multi-part index, where
    // minimap2 re-reads the query per block and merges the per-block output.
    test("Against a multi-part index, should partition reads without losing any") {
        tag "expect_success"

        when {
            params {
            }
            process {
                '''
                def minimap2_params = [
                    suffix: "multipart",
                    remove_sq: false,
                    alignment_params: "",
                    db_download_timeout: params.db_download_timeout
                ]
                input[0] = LOAD_SAMPLESHEET.out.samplesheet
                input[1] = MINIMAP2_INDEX_MULTIPART.out
                input[2] = minimap2_params
                '''
            }
        }
        then {
            assert process.success

            def fastq_read_ids_mapped = path(process.out.reads_mapped[0][1]).fastq.readNames.toSet()
            def fastq_read_ids_unmapped = path(process.out.reads_unmapped[0][1]).fastq.readNames.toSet()
            def input_reads = path(process.out.input[0][1]).fastq.readNames.toSet()

            // Every input read is accounted for exactly once. Streaming the
            // merged output through the fan-out must not drop or duplicate
            // reads across index blocks.
            assert fastq_read_ids_mapped.intersect(fastq_read_ids_unmapped).size() == 0
            assert input_reads == fastq_read_ids_mapped + fastq_read_ids_unmapped
            assert !input_reads.isEmpty()

            // The SAM branch must agree with the mapped-FASTQ branch.
            def sam_read_ids = sam(process.out.sam[0][1]).getSamLines()
                .collect { line -> line.split('\t')[0] }
                .toSet()
            assert sam_read_ids == fastq_read_ids_mapped
        }
    }


    test("Should skip sam and mapped outputs when their keep flags are false") {
        tag "expect_success"
        tag "keep_flags"
        when {
            params {
            }
            process {
                '''
                def minimap2_params = [
                    suffix: "test",
                    remove_sq: false,
                    alignment_params: "",
                    db_download_timeout: params.db_download_timeout,
                    keep_sam: false,
                    keep_mapped: false
                ]
                input[0] = LOAD_SAMPLESHEET.out.samplesheet
                input[1] = "${params.ref_dir}/results/mm2-other-index"
                input[2] = minimap2_params
                '''
            }
        }
        then {
            assert process.success
            assert process.out.sam.size() == 0
            assert process.out.reads_mapped.size() == 0
            assert process.out.reads_unmapped.size() == 1
            def unmapped = path(process.out.reads_unmapped[0][1]).fastq.readNames.toSet()
            def input_reads = path(process.out.input[0][1]).fastq.readNames.toSet()
            assert !input_reads.isEmpty()
            assert unmapped.every { it in input_reads }
        }
    }

    test("Should fail when all three keep flags are false") {
        tag "expect_failure"
        tag "keep_flags"
        when {
            params {
            }
            process {
                '''
                def minimap2_params = [
                    suffix: "test",
                    remove_sq: false,
                    alignment_params: "",
                    db_download_timeout: params.db_download_timeout,
                    keep_sam: false,
                    keep_mapped: false,
                    keep_unmapped: false
                ]
                input[0] = LOAD_SAMPLESHEET.out.samplesheet
                input[1] = "${params.ref_dir}/results/mm2-other-index"
                input[2] = minimap2_params
                '''
            }
        }
        then {
            assert process.failed
        }
    }
}
