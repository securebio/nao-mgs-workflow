/*
========================================================================================
    Nextflow config file for the Wave configuration test
========================================================================================
*/

// Relative, not ${projectDir}: that resolves to the probe script's own directory, not
// the repo root, so it can't reach configs/ the way the other test configs do.
includeConfig "../../configs/profiles.config"

// Nextflow only logs the Wave config once the client is built, and nf-test's profile
// disables Wave. Forcing it on here means the test covers the two settings' values but
// not that Wave itself is enabled in production.
wave.enabled = true
