// Fail the download of chunk_1 and ignore it, as production does once retries run out.
// Used by "Should build nothing when one chunk's download fails"
// in tests/subworkflows/local/makeVirusGenomeDB/main.nf.test
includeConfig "index.config"

process {
    withName: '.*:DOWNLOAD_VIRAL_GENOMES' {
        beforeScript = 'if grep -q "^### name: .*name=chunk_1)" .command.run; then exit 1; fi'
        errorStrategy = 'ignore'
    }
}
