// Fail BLAST for group "failed" and ignore it, as production does once retries run out.
// Used by "Should publish header-only hits for an empty group but nothing for a failed one"
// in tests/subworkflows/local/validateViralAssignments/main.nf.test
includeConfig "downstream.config"

process {
    withName: '.*:BLAST_FASTA:BLAST' {
        beforeScript = 'if grep -q "^### name: .*(id=failed)" .command.run; then exit 1; fi'
        errorStrategy = 'ignore'
    }
}
