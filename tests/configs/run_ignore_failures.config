// The production error strategy (retry, then ignore), which nf_test otherwise replaces with 'finish'.
// Used by the "Should stop the run ... even where failures are ignored" tests in
// tests/subworkflows/local/checkVersionCompatibility/main.nf.test, to show that the errorStrategy
// CHECK_VERSIONS and EXTRACT_VERSIONS set for themselves stops the run under production's strategy.
includeConfig "run.config"

profiles {
    nf_test {
        process.errorStrategy = { task.attempt <= task.maxRetries ? 'retry' : 'ignore' }
    }
}
