// Fail the download of genome "second" and ignore it, as production does once retries run out.
// Used by tests/subworkflows/local/makeContaminantIndex/main.nf.test
includeConfig "index.config"

process {
    withName: '.*:DOWNLOAD_GENOME' {
        beforeScript = 'if grep -q "^### name: .*name=second)" .command.run; then exit 1; fi'
        errorStrategy = 'ignore'
    }
}
