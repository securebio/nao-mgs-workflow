nextflow_workflow {

    name "Test mark_similarity_duplicates_resources memory-tier closure"
    script "tests/configs/resources/main.nf"
    workflow "PROBE_SIM_DUP_TIER"
    config "tests/configs/resources/nextflow.config"
    tag "config"
    tag "mark_similarity_duplicates_resources"

    test("Should map input byte size to the expected memory tier") {
        tag "expect_success"
        when {
            workflow {
                """
                input[0] = channel.of(
                    1073741824L,   // 1 GB  -> tier 0 (<= 6 GB) -> 4 GB
                    6442450944L,   // 6 GB  -> tier 0 (boundary) -> 4 GB
                    6442450945L,   // 6 GB + 1 byte -> tier 1 -> 8 GB
                    12884901888L,  // 12 GB -> tier 1 (boundary) -> 8 GB
                    25769803776L,  // 24 GB -> tier 2 (boundary) -> 16 GB
                    51539607552L,  // 48 GB -> tier 3 (boundary) -> 32 GB
                    68719476736L,  // 64 GB -> tier 4 (fallback) -> 64 GB
                )
                """
            }
        }
        then {
            assert workflow.success

            // 1 GB = 2^30 bytes.
            def gb = 1073741824L
            def expected = [
                1073741824L:  4 * gb,
                6442450944L:  4 * gb,
                6442450945L:  8 * gb,
                12884901888L: 8 * gb,
                25769803776L: 16 * gb,
                51539607552L: 32 * gb,
                68719476736L: 64 * gb,
            ]

            // Workflow emits a single CSV (one row per input, sorted).
            def report = path(workflow.out.report[0]).text.trim().split('\n')
            def actual = report.collectEntries { line ->
                def (size_bytes, allocated) = line.split(',')
                [size_bytes as Long, allocated as Long]
            }

            assert actual == expected
        }
    }
}
