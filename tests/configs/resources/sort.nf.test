// Kept in its own file rather than appended to main.nf.test: nf-test parses a
// single top-level block per file, so a second nextflow_workflow block there
// would silently shadow the bbmask_resources test.

nextflow_workflow {

    name "Test sort_file_resources / sort_fastq_resources tier closures"
    script "tests/configs/resources/main.nf"
    workflow "PROBE_SORT_RESOURCE_TIERS"
    config "tests/configs/resources/nextflow.config"
    tag "config"
    tag "sort_resources"

    test("Should map gzipped input size to the expected cpu and memory tier") {
        tag "expect_success"
        when {
            workflow {
                """
                input[0] = channel.of(
                    268435456L,   // 0.25 GB -> tier 0 (<= 0.5 GB) -> 1 cpu / 4 GB
                    536870912L,   // 0.5 GB  -> tier 0 (boundary)  -> 1 cpu / 4 GB
                    1073741824L,  // 1 GB    -> tier 1 (<= 2 GB)   -> 4 cpu / 16 GB
                    2147483648L,  // 2 GB    -> tier 1 (boundary)  -> 4 cpu / 16 GB
                    5368709120L,  // 5 GB    -> tier 2 (<= 10 GB)  -> 8 cpu / 32 GB
                    10737418240L, // 10 GB   -> tier 2 (boundary)  -> 8 cpu / 32 GB
                    21474836480L, // 20 GB   -> tier 3 (fallback)  -> 16 cpu / 64 GB
                )
                """
            }
        }
        then {
            assert workflow.success

            // Each row is [cpus, memory bytes, sort --buffer-size argument].
            // The buffer is SortUtils.BUFFER_FRACTION (0.6) of the reservation,
            // asserted explicitly so a change to that fraction has to be
            // deliberate: it is what keeps sort inside the cgroup limit.
            def gb = 1073741824L
            def expected = [
                268435456L:   [1,  4 * gb,  '2457M'],
                536870912L:   [1,  4 * gb,  '2457M'],
                1073741824L:  [4,  16 * gb, '9830M'],
                2147483648L:  [4,  16 * gb, '9830M'],
                5368709120L:  [8,  32 * gb, '19660M'],
                10737418240L: [8,  32 * gb, '19660M'],
                21474836480L: [16, 64 * gb, '39321M'],
            ]

            def parse = { p ->
                path(p).text.trim().split('\n').collectEntries { line ->
                    def (size_bytes, cpus, allocated, buffer) = line.split(',')
                    [size_bytes as Long, [cpus as Integer, allocated as Long, buffer]]
                }
            }

            // Both modules must tier identically: they run the same sort
            // pipeline and differ only in the name of their input variable.
            assert parse(workflow.out.sort_file[0]) == expected
            assert parse(workflow.out.sort_fastq[0]) == expected
        }
    }
}
